DATABASE_URL="file:./dev.db"
AUTH_SECRET="یک-رشته-تصادفی-حداقل-32-کاراکتری-اینجا"
APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAIL="admin@hawre.test"
ADMIN_PASSWORD="رمز-قوی-برای-حساب-مدیر"
SEED_USER_PASSWORD="رمز-کاربران-آزمایشی"

# اختیاری: تعیین دستی رفتار کوکی نشست (true برای اجرای پشت پروکسی/داخل iframe)
COOKIE_CROSS_SITE=""

# اختیاری: اجازه استفاده از توکن نشست جایگزین (هدر Authorization: Bearer)
# وقتی مرورگر کوکی شخص‌ثالث را بلاک می‌کند (مثلاً اجرا داخل iframe) لازم است.
# پیش‌فرض: true در توسعه، false در Production.
ALLOW_TOKEN_FALLBACK=""

# اختیاری: مقدار frame-ancestors در Content-Security-Policy
# پیش‌فرض: 'self' در Production. مثال: "'self' https://example.com"
ALLOWED_FRAME_ANCESTORS=""

# --- سرویس ایمیل (اختیاری) ---
# اگر خالی بماند، ایمیل ارسال نمی‌شود و لینک‌های تأیید/بازیابی فقط در کنسول سرور چاپ می‌شوند.
# کلید رایگان از https://resend.com (۳۰۰۰ ایمیل در ماه)
RESEND_API_KEY=""
# نشانی فرستنده؛ دامنه باید در Resend تأیید شده باشد. برای تست: "Hawre <onboarding@resend.dev>"
MAIL_FROM="Hawre <onboarding@resend.dev>"

# --- ارسال ایمیل با SMTP (جایگزین Resend؛ با هر سرویسی کار می‌کند) ---
# نمونه Gmail:  SMTP_HOST="smtp.gmail.com"  SMTP_PORT="587"  SMTP_USER="you@gmail.com"  SMTP_PASS="رمز-اپلیکیشن"
# نمونه Zoho :  SMTP_HOST="smtp.zoho.com"   SMTP_PORT="587"
# اگر SMTP_HOST پر باشد، به‌جای Resend از همین استفاده می‌شود.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
