# ---------------------------------------------------------------
# متغیرهای محیطی نسخه Production (این فایل را به .env.production کپی کنید)
# هرگز این فایل را در گیت commit نکنید.
# ---------------------------------------------------------------

# نشانی عمومی سرویس (برای لینک تأیید ایمیل و بازگشت Google)
APP_URL="https://example.com"

# کلید امضای نشست — حتماً تصادفی و حداقل ۳۲ کاراکتر:  openssl rand -base64 48
AUTH_SECRET=""

# دیتابیس: در docker-compose روی والیوم پایدار تنظیم شده و نیازی به تغییر نیست
DATABASE_URL="file:/app/data/hawre.db"

# ورود با Google (اختیاری؛ خالی بگذارید تا این دکمه غیرفعال شود)
# Redirect URI در کنسول گوگل:  https://example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# حساب مدیر — در اولین اجرا ساخته می‌شود (رمز قوی انتخاب کنید)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- گزینه‌های امنیتی ---
# اجازه نشست جایگزین با هدر Bearer. در Production پیش‌فرض false است
# و فقط اگر برنامه را داخل iframe دامنه دیگری اجرا می‌کنید true کنید.
ALLOW_TOKEN_FALLBACK="false"

# کوکی بین‌دامنه‌ای (SameSite=None). فقط برای حالت iframe لازم است.
COOKIE_CROSS_SITE="false"

# دامنه‌های مجاز برای نمایش داخل iframe
ALLOWED_FRAME_ANCESTORS="'self'"

NODE_ENV="production"

# --- سرویس ایمیل (اختیاری) ---
# اگر خالی بماند، ایمیل ارسال نمی‌شود و لینک‌های تأیید/بازیابی فقط در کنسول سرور چاپ می‌شوند.
# کلید رایگان از https://resend.com (۳۰۰۰ ایمیل در ماه)
RESEND_API_KEY=""
# نشانی فرستنده؛ دامنه باید در Resend تأیید شده باشد. برای تست: "Hawre <onboarding@resend.dev>"
MAIL_FROM="Hawre <onboarding@resend.dev>"
